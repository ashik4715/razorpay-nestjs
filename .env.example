PORT=3000

# Razorpay Test Mode keys (Dashboard -> Account & Settings -> API Keys)
RAZOR_TEST_API_KEY=rzp_test_YOUR_KEY_ID
RAZOR_TEST_API_SECRET=YOUR_KEY_SECRET

# Used to verify X-Razorpay-Signature on webhook deliveries
# (Dashboard -> Settings -> Webhooks -> secret you configured)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
